<mah:MetroWindow x:Class="SqliteManager.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 Title="SQLite Manager"
                 Height="820"
                 Width="1200"
                 WindowStartupLocation="CenterScreen"
                 Background="#1E1E1E">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <StackPanel Orientation="Horizontal"
                    Grid.Row="0"
                    Margin="0,0,0,8">

            <Button Content="Создать БД"
                    Click="CreateDb_Click"
                    Margin="4"
                    Width="120"/>

            <Button Content="Открыть БД"
                    Click="OpenDb_Click"
                    Margin="4"
                    Width="120"/>

            <TextBlock Text="Таблицы:"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="10,0,5,0"/>

            <ComboBox x:Name="TablesCombo"
                      Width="300"
                      Margin="0,0,5,0"
                      SelectionChanged="TablesCombo_SelectionChanged"/>

            <Button Content="Создать таблицу"
                    Click="CreateTable_Click"
                    Margin="4"
                    Width="140"/>

            <Button Content="Показать связи"
                    Click="ShowRelations_Click"
                    Margin="4"
                    Width="140"/>

            <Button Content="Обновить"
                    Click="ReloadTable_Click"
                    Margin="4"
                    Width="100"/>
        </StackPanel>

        <!-- Панель поиска -->
        <StackPanel Orientation="Horizontal"
                    Grid.Row="1"
                    Margin="0,0,0,8">

            <Button Content="Добавить колонку"
                    Click="AddColumn_Click"
                    Margin="4"
                    Width="150"/>

            <Button Content="Переименовать колонку"
                    Click="RenameColumn_Click"
                    Margin="4"
                    Width="180"/>

            <Button Content="Удалить колонку"
                    Click="DeleteColumn_Click"
                    Margin="4"
                    Width="150"/>

            <TextBlock Text="Поиск:"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="20,0,5,0"/>

            <TextBox x:Name="SearchBox"
                     Width="220"
                     Margin="0,0,5,0"/>

            <Button Content="Найти"
                    Click="Search_Click"
                    Margin="4"
                    Width="100"/>

            <Button Content="Сбросить фильтр"
                    Click="ClearFilter_Click"
                    Margin="4"
                    Width="150"/>

            <Button Content="Добавить строку"
                    Click="AddRow_Click"
                    Margin="4"
                    Width="140"/>

            <Button Content="Удалить выбранную"
                    Click="DeleteRow_Click"
                    Margin="4"
                    Width="170"/>

            <Button Content="Сохранить изменения"
                    Click="SaveChanges_Click"
                    Margin="4"
                    Width="180"/>
        </StackPanel>

        <!-- Таблицы -->
        <TabControl x:Name="MainTabs"
                    Grid.Row="2"
                    Margin="0,0,0,8">

            <TabItem Header="Текущая таблица">

                <Border Background="#1E1E1E"
                        Padding="5">

                    <DataGrid x:Name="DataGridMain"
                              AutoGenerateColumns="True"
                              AlternatingRowBackground="#2A2A2A"
                              Background="#1E1E1E"
                              Foreground="White"
                              GridLinesVisibility="All"
                              HeadersVisibility="All"
                              RowHeaderWidth="0"
                              MouseRightButtonDown="DataGridMain_MouseRightButtonDown"/>
                </Border>
            </TabItem>

            <TabItem Header="Результат SQL">

                <Border Background="#1E1E1E"
                        Padding="5">

                    <DataGrid x:Name="SqlResultGrid"
                              AutoGenerateColumns="True"
                              AlternatingRowBackground="#2A2A2A"
                              Background="#1E1E1E"
                              Foreground="White"
                              GridLinesVisibility="All"
                              HeadersVisibility="All"/>
                </Border>
            </TabItem>
        </TabControl>

        <!-- SQL редактор -->
        <Border Grid.Row="3"
                BorderBrush="#444"
                BorderThickness="1"
                Padding="5">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal"
                            Grid.Row="0"
                            Margin="0,0,0,5">

                    <Button Content="Выполнить SQL"
                            Click="ExecuteSql_Click"
                            Margin="4"
                            Width="150"/>

                    <Button Content="Очистить"
                            Click="ClearSql_Click"
                            Margin="4"
                            Width="100"/>
                </StackPanel>

                <avalonedit:TextEditor x:Name="SqlEditor"
                                       Grid.Row="1"
                                       FontFamily="Consolas"
                                       FontSize="14"
                                       ShowLineNumbers="True"
                                       SyntaxHighlighting="SQL"
                                       Background="#252526"
                                       Foreground="#DCDCDC"
                                       Text="SELECT * FROM products;"/>
            </Grid>
        </Border>

        <!-- Статус -->
        <StatusBar Grid.Row="4"
                   Background="#111"
                   Foreground="White">

            <TextBlock x:Name="SqlErrorText"/>
        </StatusBar>

    </Grid>
</mah:MetroWindow>